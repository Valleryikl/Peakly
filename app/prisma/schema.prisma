datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Mountain {
  id          Int   @id 
  rank        Int
  name        String
  country     String
  elevation   Int
  slogan      String?
  description String?
  coords      String?   // coords
  photoUrl    String   // photo
  videoUrl    String?  // video
}
